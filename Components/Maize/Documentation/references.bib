@article{Aufhammer1994,
 abstract = {The suitability of grain of winter wheat cv. Adular and Contra and winter triticale cv. Alamo and Lasko for ethanol production was tested 2-11 months after maturity was reached. Delay in processing increased ethanol production by up to 1.1 litres/100 kg DM when a technical enzyme preparation was added and by up to 9.6 litres/100 kg DM without added enzymes. The increase due to delay in processing was greatest in wheat cv. Contra, which gave a low ethanol yield when processed early without added enzymes. Ethanol yield/ha was affected by the differential responses of the cultivars to delay in harvesting and processing and the use of technical enzymes. The falling number of the grain was of limited use in forecasting its suitability for autoamylolytic processing.},
