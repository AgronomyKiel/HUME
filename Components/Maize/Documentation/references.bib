@article{Jakobsen1989,
 abstract = {A model describing root growth, water uptake and yield of wheat depending on soil structure under Australian conditions was modified to describe Swedish conditions of deeper tillage and shorter growing season. Field harvest data from soil compaction experiments at Uppsala and Kristianstad in 1977-85 were compared with simulated crop yields from the modified model. Soil strength, macroporosity, hydraulic conductivity and water storage all had large effects on the predicted yields and were more critical under the Swedish conditions than under those of the original model. In some years a single parameter had such an extreme effect on predicted yields that the available soil descriptions were not adequate. It is suggested that field measurements of plant water stress and root profiles at different stages of development and inclusion of different sizes of cracks and biopores in any soil profile could improve prediction by the model},
 author = {Jakobsen, B. F. and Dexter, A. R. and Hakansson, I.},
 year = {1989},
 title = {Simulation of the response of cereal crops to soil compaction},
 pages = {203--212},
 volume = {19},
 journal = {Swedish Journal of Agricultural Research}
}

@article{JalaliFarahani1993,
 author = {Jalali-Farahani, H. R. and Slack, D. C. and Kopec, D. M. and Matthias, A. D.},
