 year = {2003},
 title = {Physiological characterization of 'stay green' mutants in durum wheat},
 pages = {1415--1420},
 volume = {54},
 number = {386},
 journal = {J. Exp. Bot.}
}

@article{Sparkes2006,
 abstract = {Field experiments at Sutton Bonington, Nottinghamshire, UK, in 2001-2003 involving wheat grown at contrasting plant populations and nitrogen availabilities created crops with widely varying tiller production and survival patterns. These crops were used to investigate the 'trigger mechanism' responsible for the start of tiller death. The date of maximum shoot number ranged from 5 February to 16 May at which time the developmental stage was anywhere between GS27 and GS39. There was no correlation between radiation available per shoot and the beginning of tiller death. The start of tiller death was closely related to the red to far red ratio (R:FR) measured at the base of the canopy and we propose a critical R:FR for the initiation of tiller death in winter wheat. We also suggest that this critical R:FR interacts with leaf nitrogen content--where leaf nitrogen content is higher, the critical R:FR is lower: in other words, when more nitrogen is available, the canopy is allowed to grow larger before tiller death starts and vice versa.},
 author = {Sparkes, D. L. and Holme, S. J. and Gaju, O.},
 year = {2006},
 title = {Does light quality initiate tiller death in wheat?},
 keywords = {Light quality;Red/far red ratio;Tillering;winter wheat},
 pages = {212--217},
 volume = {24},
 number = {3},
 issn = {1161-0301},
 journal = {European Journal of Agronomy}
}

