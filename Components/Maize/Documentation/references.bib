@article{Colnenne1998,
 abstract = {In field and controlled environment experiments conducted

                             between 1992 and 1995 in France, plants of winter oilseed rape

                             cv. Goeland were grown under various conditions of N availability.

                             The theoretical critical N points, calculated using 15 groups of

                             experimental data, allowed computation of the critical N dilution

                             curve, N = 4.48 W-0.25, where N is the total N concentration in

                             the shoot biomass and W is the shoot biomass in t/ha. The curve

                             was validated over the range of shoot dry matter from 0.88 to 6.3

                             t/ha, but the equation did not apply when shoot biomass was

                             {\textless}0.88 t/ha. In this case, the critical N concentration was

                             independent of shoot biomass; the constant critical N-value 4.63{\%}

                             N is proposed, using reduced N as the form of N analysed. The

                             validity and stability of the critical N dilution curve was confirmed

                             in several pedoclimatic conditions in France. Significant

                             differences were observed between the critical N dilution curves

                             for winter oilseed rape and wheat, and these differences were

                             explained in terms of various phenomena.},
 author = {Colnenne, C. and Meynard, J. M. and Reau, R. and Justes, E. and Merrien, A.},
 year = {1998},
 title = {Determination of a critical nitrogen dilution curve for winter oilseed rape},
 pages = {311--317},
 volume = {81},
 number = {2},
 issn = {0305-7364},
 journal = {Annals of Botany}
}

