@article{Kirkegaard2007,
 abstract = {Water stored deep in the soil profile is generally considered valuable to crop yield because it becomes available during grain filling, but the value of subsoil water for grain yield has not been isolated and quantified in the field. We used rainout shelters with irrigation to control the water supply to wheat crops that had different amounts of subsoil water available to isolate and quantify the efficiency with which the subsoil water was converted to grain yield. Under moderate post-anthesis stress, 10.5mm of additional subsoil water used in the 1.35-1.85m layer after anthesis increased grain yield by 0.62 t/ha, representing an efficiency of 59 kg/ha. mm. The additional yield resulted from a period of higher assimilation 12-27 days after anthesis and was related to an increase in grain size rather than other yield components. Under more severe stress with earlier onset, extra water use below 1.25m was accompanied by additional water use in upper soil layers and it was more difficult to isolate and quantify the benefit of deep water to grain yield. The additional water used from all layers from the time the stress was imposed was converted to grain at 30-40 kg/ha. mm, but this increased to 60 kg/ha. mm for water used after anthesis. The high efficiency for subsoil water use is 3 times that typically expected for total seasonal water use, and twice that previously estimated for total post-anthesis water use in a similar environment. The results demonstrate that relatively small amounts of subsoil water can be highly valuable to grain yield.},
 author = {Kirkegaard, J. A. and Lilley, J. M. and Howe, G. N. and Graham, J. M.},
 year = {2007},
 title = {Impact of subsoil water use on wheat yield},
 keywords = {AUSTRALIA;Crop yield;drought;DRYLAND WHEAT;ENVIRONMENTS;growth;limitations;marginal water-use efficiency;OPPORTUNITIES;ROOT SYSTEMS;soil;transpiration efficiency;use efficiency;water-soluble carbohydrate},
 pages = {303--315},
 volume = {58},
 number = {4},
 issn = {0004-9409},
 journal = {Australian Journal of Agricultural Research},
 doi = {10.1071/ar06285}
}

@article{Kirkegaard2018,
 abstract = {Despite its global significance as an edible oil and biofuel, the critical period for yield determination in canola (edible oilseed rape - Brassica napus L.) has not been determined in the field. Field experiments were conducted at two contrasting sites in southern Australia where 100 degrees Cd shading periods (15{\%} PAR transmitted) were applied from early vegetative growth until maturity to identify the developmental period when the crop was most sensitive to stress. Despite the significant difference between the two sites for yield in the unshaded control (450 gm(-2) in New South Wales, and 340 gm(-2) in South Australia), the critical period was consistent at both sites extending from 100 to 500 degrees Cd after the start of flowering (BBCH60), and centred 300 degrees Cd after BBCH60. Seed number (seed m(-2)) was reduced by an average of 48{\%} in the critical period, generated in equal parts by reduced pod m(-2) in the early part of the period, and reduced seed pod(-1) in the latter part. Reduced seed number was partially compensated by an increase in seed size of 29{\%}. These trends were similar on the branches and main stem. On the main stem, the timing of the critical period moved from earlier to later from lower to upper pods linked to the timing of their development. Seed oil content declined and protein content increased under shading in the critical period, while both oil and protein yield (kgm(-2)) were reduced by 40-50{\%} and 30-40{\%} respectively. The critical period is coincident with the greatest number of near-open buds and newly opened flowers, which are highly sensitive to assimilate supply for ovule development. Both pod abortion and restricted capacity for compensatory growth of surviving pods are consequences of assimilate restriction on developing ovules. Identification of the critical period provides a useful target for breeding and management strategies to maximize productivity.},
 author = {Kirkegaard, J. A. and Lilley, J. M. and Brill, R. D. and Ware, A. H. and Walela, C. K.},
 year = {2018},
 title = {The critical period for yield and quality determination in canola (Brassica naps L.)},
 keywords = {AUSTRALIA;Barley;FIELD PEA;growth;OILSEED;oilseed rape;pod;quantitative-analysis;RAPESEED;Seed number;Seed size;Stress;temperature;Wheat;yield components},
 pages = {180--188},
 volume = {222},
 issn = {0378-4290},
 journal = {Field Crops Research},
 doi = {10.1016/j.fcr.2018.03.018}
}

@article{Kirkegaard2018b,
 abstract = {Despite its global significance as an edible oil and biofuel, the critical period for yield determination in canola (edible oilseed rape -- Brassica napus L.) has not been determined in the field. Field experiments were conducted at two contrasting sites in southern Australia where 100 °Cd shading periods (15{\%} PAR transmitted) were applied from early vegetative growth until maturity to identify the developmental period when the crop was most sensitive to stress. Despite the significant difference between the two sites for yield in the unshaded control (450 g m$-$2 in New South Wales, and 340 g m$-$2 in South Australia), the critical period was consistent at both sites extending from 100 to 500 °Cd after the start of flowering (BBCH60), and centred 300 °Cd after BBCH60. Seed number (seed m$-$2) was reduced by an average of 48{\%} in the critical period, generated in equal parts by reduced pod m$-$2 in the early part of the period, and reduced seed pod$-$1 in the latter part. Reduced seed number was partially compensated by an increase in seed size of 29{\%}. These trends were similar on the branches and main stem. On the main stem, the timing of the critical period moved from earlier to later from lower to upper pods linked to the timing of their development. Seed oil content declined and protein content increased under shading in the critical period, while both oil and protein yield (kg m$-$2) were reduced by 40--50{\%} and 30--40{\%} respectively. The critical period is coincident with the greatest number of near-open buds and newly opened flowers, which are highly sensitive to assimilate supply for ovule development. Both pod abortion and restricted capacity for compensatory growth of surviving pods are consequences of assimilate restriction on developing ovules. Identification of the critical period provides a useful target for breeding and management strategies to maximize productivity.},
 author = {Kirkegaard, John A. and Lilley, Julianne M. and Brill, Rohan D. and Ware, Andrew H. and Walela, Christine K.},
 year = {2018},
 title = {The critical period for yield and quality determination in canola (Brassica napus L.)},
 keywords = {OILSEED;RAPESEED;Seed number;Seed size;Stress;yield components},
