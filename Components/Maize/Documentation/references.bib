@article{Aggarwal1997,
 abstract = {A simulation model was used to examine the opportunities for increasing

                              irrigated rice yield in the dry season of a tropical climate by altering durations

                              of juvenile and panicle formation phases, specific leaf area, maximum leaf N

                              concentration, spikelet growth factor and potential grain weight. The study was

                              conducted for three levels of N management: practices followed in breeder's

                              screening plots; agronomic recommendations for high yield potential; and

                              growth-rate-driven N uptake. The results revealed that rice cv. IR72 has a

                              large yield potential that can be realized with better N management. No trait

                              individually or in combination provided more than 5{\%} advantage in yield in the

                              level of management typically practiced by breeders. In such environments,

                              even though genotypes may possess traits for higher yield potential, they will

                              not be able to express them. The simulations predicted that significantly higher

                              rates of N input and precise timing are required to attain a grain yield potential

                              greater than 10 t/ha. It is concluded that if plant N status can be increased

                              without lodging or disease problems, a significant increase in yield requires

                              increased sink capacity, maintenance of high leaf N content and a longer

                              grain-filling duration.},
 author = {Aggarwal, P. K. and Kropff, M. J. and Cassman, K. G. and {ten{\_}Berge,  H F M}},
 year = {1997},
 title = {Simulating genotypic strategies for increasing rice yield potential in irrigated, tropical environments},
 pages = {5--17},
 volume = {51},
 number = {1-2},
 issn = {0378-4290},
 journal = {Field Crops Research}
}

