@article{Ketelsen1999,
 abstract = {Eine Methode zur Absch{\"a}tzung der Nitratkonzentration im Sickerwasser unter beweidetem Gr{\"u}nland mit dem

 Bodenwasserhaushalts- und Bodenstickstoffmodell WASMOD wird vorgestellt. Die Kalkulation des N-Eintrags auf die Weide

 {\"u}ber den Urin und den Kot der Rinder (70 - 95{\%} des Futter-N) erfolgt dabei als Funktion der Beweidungsintensit{\"a}t, der

 Weidedauer und von Messwerten der t{\"a}glichen N-Ausscheidung mit dem Urin und dem Kot (Literaturdaten). Der Urin-N wird

 als NH4+-D{\"u}nger simuliert, der Kot-N als organischer N-D{\"u}nger mit einem C/N-Verh{\"a}ltnis von 18,6:1. Das Modell wurde am

 Beispiel des Wasserschutzgebiets F{\"o}hr-West und einem 35j{\"a}hrigen Klimaszenario {\"u}berpr{\"u}ft. Die vom Modell berechnete,

 mittlere Nitratkonzentration im Sickerwasser unter (M{\"a}h)weiden (55,5 mg l-1) stimmt mit dem Konzentrationsmittel der

 Wasserwerksbrunnen (59,5 mg l-1) gut {\"u}berein. Szenariorechnungen deuten an, dass die Halbtagsweide in Kombination mit

 einer Vermeidung der Herbstweide die Nitratkonzentration des Sickerwassers im langj{\"a}hrigen Mittel um etwa 40{\%} absenken

 kann.},
 author = {Ketelsen, Hark and Hansen, Jens and Reiche, Ernst-Walter},
 year = {1999},
 title = {Modellstudien zur Nitratauswaschung unter beweidetem Gr{\"u}nland},
 pages = {685--696},
 volume = {162},
 number = {6},
 journal = {Z. Pflanzenern{\"a}hr. Bodenkde.}
}

