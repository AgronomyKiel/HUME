@article{Muro1998,
 abstract = {Experiments were designed to assess the effects of defoliation and bending back petioles on the head mass of cauliflower (Brassica oleracea L. Var. Botrytis Alef. Subvar. Cauliflora. Cv. Matra) in the Central Ebro Valley of Spain. Treatments were applied at seven different stages during the growth cycle. Defoliation reduced final head mass, the amount of the reduction increasing with level of defoliation. Bending back the petioles produced a loss in head mass intermediate between that caused by 33{\%} and 66{\%} defoliation. In all four trials, mass loss was highest when defoliation occurred at a head diameter between 20 and 38 mm. Neither defoliation nor bending of the petioles appeared to influence head induction or length of the production cycle. Maximum loss of head mass (85.4{\%} to 64.9{\%}) occnrred when cauliflower was totally defoliated at a head diameter of 20-25 mm.},
 author = {Muro, J. and Irigoyen, I. and Lamsfus, C.},
 year = {1998},
 title = {Using defoliation to estimate yield losses in cauliflower: Application in hail damage assessment},
 keywords = {Brassica oleracea/curd/cycle length/yield loss},
