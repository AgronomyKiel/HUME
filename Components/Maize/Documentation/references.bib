@article{Matthews1997,
 abstract = {To investigate how a knowledge of spatial variation in soil depth could be used to

                             optimize the use of resources in a precision farming context, the CERES-Wheat

                             simulation model was used to derive response curves of wheat grain yield to nitrogen

                             applied for a range of soil depths for a number of years. Distribution of applied

                             nitrogen across a field was then optimized by repeatedly maximizing the marginal

                             responses to incremental units of fertilizer, with the goal of minimizing the amount of

                             fertilizer required to obtain the same yield that would be obtained from a uniform

                             application. There was a wide variation in the predicted curves describing the yield

                             response to applied nitrogen in different seasons, reflecting the influence of

                             environmental variables, particularly rainfall. Optimization analysis, in which overall

                             yields were maintained at the level attained with a uniform application, suggested that

                             little fertilizer ($\div$2{\%}) could be saved by variable rates of application in a relatively

                             wet year, but that larger savings ($\div$25{\%}) were possible in a dry year. The optimal

                             distribution was when more fertilizer was applied to the parts of the field with deeper

                             soils, where the potential yield was greater, and less to the shallower parts of the field.

                             The approach demonstrates the possibility of using crop simulation models to predict

                             yield response curves for different regions of a variable field to aid in the development

                             of treatment maps for variable rate applications of specific inputs.},
 author = {Matthews, R. B. and Cosser, N. D.},
 year = {1997},
 title = {Using crop simulation models to develop treatment maps in precision agriculture},
 pages = {181--190},
 volume = {50},
 journal = {Aspects of Applied Biology}
}

