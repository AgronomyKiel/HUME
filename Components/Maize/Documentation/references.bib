@article{Menke2015,
 abstract = {In the wake of the {\textquotedbl}greening{\textquotedbl} requirements that are part of the new legal framework of the European Commission, the cultivation of cover crops, including winter cover crops, will gain importance. An approach is submitted to evaluate winter cover crops. From the manifold economic and ecological services of winter cover crops, three parameters are selected and evaluated: (1) nitrogen conservation during the winter, (2) methane production, and (3) preceding crop effects on maize. The evaluation is carried out using simple sub-indices mathematically designed in such a way that they are greater the better the performance of the winter cover crop is. Finally, the three sub-indices are added together to obtain the {\textquotedbl}Index of relative cultivation advantage{\textquotedbl} (IrA). 33 winter cover crop variants were grown in two-year field trials and the sub-indices calculated. The most favorable IrA values attained mixed stands like the {\textquotedbl}Landsberger Gemenge{\textquotedbl} (hairy vetch + Italian ryegrass + crimson clover) and {\textquotedbl}Wickroggen{\textquotedbl} (rye + hairy vetch). Winter cereals performed comparatively poorly. Based on the IrA, the large-grained legumes, winter faba beans and winter peas, had the lowest cultivation potential. IrA can be used for a weak point analysis. Thus, for the winter faba beans, a novel cropping system was already presented which is able to compensate for this field crop's biggest disadvantage, namely its poor nitrogen uptake during the winter months. The sub-indices can be weighted and thus adapted to specific local conditions. Expansion options for IrA could be for example sub-indices for ensilability, water requirement and root growth (humus effect). Furthermore, socioeconomically-oriented sub-indices are conceivable. An individual sub-index now results from the deviation of a specific performance of a winter cover crop from the mean performance of all tested winter cover crops. It seems possible to use fixed target values instead of the mean performance of all tested winter cover crops.},
 author = {Menke, C. A. and Rauber, R.},
 year = {2015},
 title = {Evaluation of winter cover crops preceding maize for biogas utilization},
 keywords = {ACCUMULATION;EFFICIENCY;mineralization;nitrogen catch crops;ROOT-GROWTH;soil;SUGAR-BEET},
 volume = {93},
 number = {3},
 issn = {2196-5099},
 journal = {Berichte Uber Landwirtschaft}
}

