@article{Rahn1992,
 abstract = {Vegetable crops leave large residues of unmarketable material after harvest.

                              The release of nitrogen from these residues was investigated on a fertile silt

                              soil in Lincolnshire, UK. Four crops were grown in succession; early summer

                              cauliflowers (planted July 1988), autumn cauliflowers (planted June 1988),

                              Brussels sprouts (planted May 1989) followed by spring barley (sown

                              February 1990). Where nitrogen had been applied to achieve maximum

                              marketable yield, Brassica debris at harvest contained 94, 107 and 183 kg

                              N/ha. Soil mineral nitrogen (0-90 cm depth) at harvest was 164, 136, and 43

                              kg/ha after the three Brassica crops. Nitrogen was mineralized from early

                              summer cauliflower debris within 14 days, but only after several months from

                              Brussel sprouts. The spring barley crop was able to utilize the nitrogen from

                              the sprout residues.},
 author = {Rahn, C. R. and Vaidyanathan, L. V. and Peterson, C. D.},
