@article{Hijmans1996,
 abstract = {Quantitative information on land use can be confronted with social, economic and environmental objectives in interactive multiple-goal linear programming (IMGLP) models to explore land use options. For various reasons, quantitative information on land use (input-output combinations) and resources is often aggregated to administrative units when integrated in the IMGLP model. In this paper, consequences of aggregating spatial units in an IMGLP model are analyzed for both a schematized and an existing IMGLP model (GOAL) exploring land use options for the European Union. A discrimination was made between effects on objective functions for the system as a whole, and effects on related optimum land use allocation within the system. In GOAL, effects on land use allocation tend to be more import-ant than effects on the value of objective functions. Several rules or factors were identified that determine the effect of aggregation, among which the degree in curvilinearity in input-output relations and the method of aggregation are important ones. However, because of many complicated interacting effects, the aggregation error is difficult to predict. Therefore, in land use studies using IMGLP, the motto is 'first optimize the linear programming model at the non-aggregated level and then aggregate to the appropriate policy level'. If aggregation is inevitable because LP models become too big, aggregation according to agro-ecological criteria, i.e., aggregation of units with similar output-input ratios and constraints, results in the smallest errors.},
 author = {Hijmans, R. J. and vanIttersum, M. K.},
 year = {1996},
 title = {Aggregation of spatial units in linear programming models to explore land use options},
 keywords = {european-community bounds;linear programming IMGLP aggregation land use allocation land use;options},
 pages = {145--162},
 volume = {44},
 number = {2},
 issn = {0028-2928},
 journal = {Netherlands Journal of Agricultural Science}
}

@article{Hikosaka1994,
 abstract = {The N content of leaves of I. tricolor cv. Heavenly Blue grown

                             horizontally was highest in newly developed young leaves and

                             decreased with leaf age in plants grown at low nitrate

                             concentrations and with all leaves exposed to full sunlight. Thus, a

                             distinct gradient of leaf N concentration was formed along the

                             gradient of leaf age. However, no gradient of leaf N concentration

                             was formed in plants grown at a high nitrate concentration. Effects

                             of PFD on N distribution were examined by shading leaves in a

                             manner that simulated changes in the light gradient of an erect

                             herbaceous canopy (i.e., where old leaves were placed under

                             increasingly darker conditions with growth of the canopy). This

                             canopy-type shading increased the gradient of leaf N concentration

                             in plants grown with a low nitrate supply and created a gradient in

                             plants grown with a high nitrate supply. The steeper the gradient of

                             PFD, the larger the gradient of leaf N that was formed. When the

                             gradient of shading was inverted, that is, younger leaves were

                             subjected to increasingly heavier shade, while keeping the oldest

                             leaves exposed to full sunlight, an inverted gradient of leaf N was

                             formed at high nitrate concentrations. The gradient of leaf N

                             generated either by advance of leaf age at low N availability or by

                             canopy-type shading was comparable to those reported for the

                             canopies of erect herbaceous plants. It is concluded that both leaf

                             age and PFD have potential to cause the non-uniform distribution of

                             leaf N. It is also shown that the contribution of leaf age increases

                             with the decrease in N nutrition level.},
 author = {Hikosaka, K. and Terashima, I. and Katoh, S.},
 year = {1994},
 title = {Effects of leaf age, nitrogen nutrition and photon flux density on the distribution of nitrogen among leaves of a vine (Ipomoea tricolor Cav.) grown horizontally to avoid mutual shading of leaves},
 pages = {451--457},
 volume = {97},
 number = {4},
 issn = {0029-8549},
 journal = {Oecologia}
}

