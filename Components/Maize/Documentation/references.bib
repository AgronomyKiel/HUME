@article{Yan2002,
 abstract = {White lupin (Lupinus albus) is able to adapt to phosphorus deficiency by producing proteoid roots that release a huge amount of organic acids, resulting in mobilization of sparingly soluble soil phosphate in rhizosphere. The mechanisms responsible for the release of organic acids by proteoid root cells, especially the trans-membrane transport processes, have not been elucidated. Because of high cytosolic pH, the release of undissociated organic acids is not probable. In the present study, we focused on H+ export by plasma membrane H+ ATPase in active proteoid roots. In vivo, rhizosphere acidification of active proteoid roots was vanadate sensitive. Plasma membranes were isolated from proteoid roots and lateral roots from P-deficient and -sufficient plants. In vitro, in comparison with two types of lateral roots and proteoid roots of P-sufficient plants, the following increase of the various parameters was induced in active proteoid roots of P-deficient plants: (a) hydrolytic ATPase activity, (b) V max andK m, (c) H+ ATPase enzyme concentration of plasma membrane, (d) H+-pumping activity, (e) pH gradient across the membrane of plasmalemma vesicles, and (f) passive H+ permeability of plasma membrane. In addition, lower vanadate sensitivity and more acidic pH optimum were determined for plasma membrane ATPase of active proteoid roots. Our data support the hypothesis that in active proteoid root cells, H+ and organic anions are exported separately, and that modification of plasma membrane H+ ATPase is essential for enhanced rhizosphere acidification by active proteoid roots.},
 author = {Yan, Feng and Zhu, Yiyong and M{\"u}ller, Caroline and Z{\"o}rb, Christian and Schubert, Sven},
 year = {2002},
 title = {Adaptation of H+-Pumping and Plasma Membrane H+ ATPase Activity in Proteoid Roots of White Lupin under Phosphate Deficiency},
 pages = {50--63},
 volume = {129},
 number = {1},
 issn = {0032-0889},
 journal = {Plant Physiology},
 doi = {10.1104/pp.010869}
}

@article{Yan2004,
 abstract = {Plants with a winter growth habit flower earlier when exposed for several weeks to cold temperatures, a process called vernalization. We report here the positional cloning of the wheat vernalization gene VRN2, a dominant repressor of flowering that is down-regulated by vernalization. Loss of function of VRN2, whether by natural mutations or deletions, resulted in spring lines, which do not require vernalization to flower. Reduction of the RNA level of VRN2 by RNA interference accelerated the flowering time of transgenic winter-wheat plants by more than a month.},
 author = {Yan, L. L. and Loukoianov, A. and Blechl, A. and Tranquilli, G. and Ramakrishna, W. and SanMiguel, P. and Bennetzen, J. L. and Echenique, V. and Dubcovsky, J.},
 year = {2004},
 title = {The wheat VRN2 gene is a flowering repressor down-regulated by vernalization},
 keywords = {Arabidopsis;Barley;ENCODES;PROTEIN;TIME},
 pages = {1640--1644},
 volume = {303},
 number = {5664},
 issn = {0036-8075},
 journal = {Science}
}

