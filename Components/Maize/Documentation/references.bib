@incollection{Slafer2021,
 abstract = {Wheat is a pillar for food security, which is grown across environments, and provides ~ 20{\%} of calories and proteins to human nutrition. Grains are mainly composed of carbohydrates (70{\%}--80{\%}) and proteins (8{\%}--22{\%}). A wide variability in developmental and growth processes in responses to genetic, environmental, and management factors has been reported. In this chapter, we reviewed the environmental and genetic drivers of development and growth, ultimately determining yield. The whole analysis is based on the concept of critical periods in which developmental and growth traits influence yield. Crop growth was approached from the capture of resources (radiation, water, and nutrients) and their use efficiencies. The impact of management practices on yield and grain quality is discussed, including the challenge of balancing intensification and sustainability in the context of climate change.},
 author = {Slafer, Gustavo A. and Savin, Roxana and Pinochet, Dante and Calderini, Daniel F.},
 title = {Chapter 3 - Wheat},
 url = {https://www.sciencedirect.com/science/article/pii/B9780128191941000037},
 keywords = {climate change;Tillering;Wheat breeding;Wheat production;Wheat water use efficiency;yield},
 pages = {98--163},
 publisher = {{Academic Press}},
 isbn = {978-0-12-819194-1},
