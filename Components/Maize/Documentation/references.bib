 year = {2005},
 title = {Dynamics of nitrogen uptake and mobilization in field-grown winter oilseed rape (Brassica napus) from stem extension to harvest - I. Global N flows between vegetative and reproductive tissues in relation to leaf fall and their residual N},
 keywords = {Brassica napus leaf nodes N-15 labelling dynamics uptake;partitioning mobilization;systems canola leaves;yield remobilization components fertilizer wheat l. efficiency},
