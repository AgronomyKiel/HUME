@article{Faget2012,
 abstract = {The use of living mulch (LM) systems for maize (Zea mays L) cultivation

may reduce soil erosion and nitrate leaching. However, the yield of

maize cultivated in LM is lower than in conventional farming systems.

This decrease has often been attributed to belowground competition, but

the lack of a suitable method to demonstrate such competition has

prevented further investigation. A recently developed method allows for

the direct and non-destructive observation of root growth in LM. Maize

expressing a green fluorescence protein was grown in monoculture or

together with Italian ryegrass (Lolium multiflorum Lam.). Root growth

was screened in minirhizotrons from the time of sowing to the anthesis

maize.

Compared with the maize cultivated without Italian ryegrass, the

cultivation in the LM significantly (p{\textless}0.05) reduced the shoot dry

matter (56{\%}), leaf area (39{\%}) and mean root density (41{\%}) of the

maize at anthesis. An analysis of variance showed that the reduction due

to the living Italian ryegrass in the root density of the maize was not

significantly different from the reduction in leaf area. Similarly, the

reduction in the root density and shoot dry matter of the maize were not

significantly different. The roots of the LM maize grew in the soil

where the LM was removed but also where the LM continued growing. This

study constitutes the first direct quantification of root growth and

distribution in a LM system. (C) 2011 Elsevier B.V. All rights reserved.},
 author = {Faget, Marc and Liedgens, Markus and Feil, Boy and Stamp, Peter and Herrera, Juan M.},
 year = {2012},
 title = {Root growth of maize in an Italian ryegrass living mulch studied with a  non-destructive method},
 pages = {1--8},
 volume = {36},
 number = {1},
 issn = {1161-0301},
 journal = {European Journal of Agronomy},
 doi = {10.1016/j.eja.2011.08.002}
}

