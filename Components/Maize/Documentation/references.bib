@article{Kenter2002,
 abstract = {In order to study the development of yield parameters and quality

components of sugarbeet under different environmental conditions, a

trial series was carried out in the years 2000 and 2001 at eleven sites

in Germany, partly with the possibility of additional sprinkler

irrigation. A linear increase of the leaf area index with thermal time

during the first 90 days after sowing, i.e. to approximately the end of

June, was observed in both years and all locations. In the second half

of the vegetation period, an influence of temperature on the development

of the canopy was no longer provable. Until 150 days past sowing (at the

end of August), the growth rate of the beet root was regulated

predominantly by the leaf area. Above a leaf area index of approx. 4, no

further increase of the growth rate was registered. In September and

October the dry matter formation of the beet decreased strongly,

independently of the leaf area index.

In the year 2001, in a trial with and without irrigation, a clear

influence of the water supply on yield and quality formation of the

sugarbeet was found. The growth rates of both leaf and beet root were

clearly higher after sprinkler irrigation than in the rainfed treatment.

The growth rate of the root responded to the water supply with a delay

of approx. 14 days. Without irrigation, sugar content and

alpha-amino-nitrogen content temporarily increased due to summer

drought, whilst betaine content remained elevated until final harvest.},
 author = {Kenter, C. and Hoffmann, C.},
 year = {2002},
 title = {Yield and quality formation of sugarbeet as affected by temperature and  water supply},
 keywords = {beet growth;crop growth rate;irrigation;Leaf area index;technical quality;temperature;water stress},
 pages = {690--698},
 volume = {127},
 number = {9},
 issn = {0344-8657},
 journal = {Zuckerindustrie}
}

