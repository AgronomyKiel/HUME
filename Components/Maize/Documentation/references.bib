@article{Fischbeck1993,
 abstract = {Investigations on supplemental N-fertilizer application for the optimum course of N-uptake into winter wheat stands During a period of 5 years 14 N-fertilization field trials with winter wheat have been carried out in which N-uptake and biomass production in 6 growth stages were analysed. By comparison with non-optimal variants of N-supply a critical range for N-uptake has been recognized which centered around an optimum value of 86 kg biomass N/ha at growth stage EC32. In connection with intensified N-uptake during later growth stages, this has allowed full exploitation of the wheat yield potential without substantial decrease of the N-harvest index. Field trials on two different soil types (Parabraunerde and humose Auenrendzina), different dates of sowing and long year stands in wheat monoculture as well as applications of N-fertilizers containing dicyandiamid for delay of nitrification showed differences in efficiency as related to the fertilizer dosages but no systematic deviation from the optimum course of N-uptake for full exploitation of yield potential. Provided that excessive fertilizer dosages before EC32 had been avoided, it seems possible to adjust the reuptake of winter wheat stands close to its optimum within an error of not more than 30 kg fertilizer N/ha by growth stage oriented splittings of fertilizer application and adequate account of soil-N supply and weather conditions during early growth stages. Full exploitation of the wheat yield potential has been possible in all trials without significant losses in N-use efficiency if optimal splittings and dosages of supplemental N-fertilizers were provided.

Aus 14 N-D{\"u}ngungsversuchen in 5 Versuchs-jahren wurde der Verlauf der N-Aufnahme in die oberirdische Biomasse von Winterweizen durch Teilernten in 6 Entwicklungsstadien und seine Verteilung auf Korn und Stroh im Erntegut ermittelt. Im Vergleich verschiedener Varianten der N-Versorgung war ein kritischer Bereich f{\"u}r die N-Aufnahme bis zum 2-Knoten-Stadium (EC32) mit einem Optimalwert um 86 kg N/ha erkennbar. In Verbindung mit einer danach einsetzenden Intensivierung der N-Aufnahme erm{\"o}glichte er die volle Aussch{\"o}pfung des Ertragspotentials, ohne die Einlagerung des zus{\"a}tzlich aufgenommenen Stickstoffs in das erntereife Korn zu beeintr{\"a}chtigen. Im Vergleich von Versuchen auf 2 unter-schiedlichen B{\"o}den (Parabraunerde und humose Auenrendzina), bei Fr{\"u}hsaaten und in Monokultur-Weizen sowie bei Einsatz von nitrifikationshemmenden Dicyandiamid-haltigen N-D{\"u}ngern ergaben sich z. T. deutliche Unterschiede in der Ausnutzung des ausge-brachten D{\"u}nger-Stickstoffs. Trotzdem wurden keine systematischen Abweichungen von dem bei voller Aussch{\"o}pfung des Ertragspotentials ermittelten Verlauf der N-Aufnahme und der Einhaltung des Optimalwertes um 86 kg N/ha in EC32 festgestellt. Die Optimierung erg{\"a}nzender N-D{\"u}ngungsma{\ss}nahmen war gekennzeichnet durch Vermeidung {\"u}berh{\"o}hter Anfangsgaben, und unter Ber{\"u}cksichtigung des N-Angebots aus dem Boden sowie des Verlaufs der Fr{\"u}hjahrs-witterung. Die Einhaltung eines optimalen Verlaufs der N-Aufnahme konnte mit einer stadienorientierten Auftrennung der Fr{\"u}hjahrsd{\"u}ngung erreicht werden. Die zur Aussch{\"o}pfung des Ertragspotentials ben{\"o}tigte Gesamtdosis lie{\ss} sich damit auf einen Schwankungsbereich von 30 kg N/ha einschr{\"a}nken. In keinem Fall mu{\ss}te bei optimaler Auftrennung der D{\"u}ngergaben der N-Aufnahme zur Aussch{\"o}pfung des Ertragspotentials auf hohe Ausnutzungsraten f{\"u}r den ausgebrachten N-D{\"u}nger verzichtet werden.},
 author = {Fischbeck, G. and Dennert, J. and Muller, R.},
 year = {1993},
 title = {Untersuchungen zur Optimierung der N-Aufnahme von Winterweizenbest{\"a}nden durch erg{\"a}nzende D{\"u}ngungma{\ss}nahmen},
 keywords = {growth stages;N-FERTILIZATION;N-harvest index;N-uptake;winter wheat},
 pages = {82--95},
 volume = {171},
 number = {2},
 issn = {0931-2250},
 journal = {Journal of Agronomy and Crop Science},
 doi = {10.1111/j.1439-037X.1993.tb00117.x}
}

