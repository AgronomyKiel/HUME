@article{Schjoerring1995,
 abstract = {In a field experiment near Copenhagen, Denmark, rape cv. Ceres was given 0,

100 or 200 kg N/ha and irrigated at a deficit of 20 mm or not irrigated. N was

labelled (15N) and the total amount of irrigation water applied was 260 mm,

split over 13 occasions in a 7-week period ranging from 1 week before onset

of flowering until 4 weeks after flowering. N application and irrigation increased

plant growth and N accumulation. Irrespective of N and irrigation treatment

more then 50{\%} of total shoot N was present in the stem when flowering

started. At the end of flowering, pod walls were the main N store containing

about 30-40{\%} of shoot N. The quantities of N remobilized from stems and pod

walls amounted in all treatments to about 70{\%} of the N present in these

organs at mid-flowering. At harvest, stem and pod walls each contained about

10{\%} of total shoot N, the remaining 80{\%} being incorporated into seeds. The

main component contributing to the response of seed N accumulation to

nitrogen application and irrigation was pods in axillary racemes. Up to 20 kg

N/ha, corresponding to about 10{\%} of final shoot N content, was lost from the

plants by leaf drop. Irrigation increased the recovery at harvest of applied N

from 30 to about 50{\%}, while the level of N application did not affect the N

recovery. 15N labelled (fertilizer derived) N constituted a greater proportion of

the N content in old leaves than in young leaves and increased with age in the

former, but not in the latter. Relative to soil N, fertilizer derived N also

contributed more to the N content of vegetative than to that of reproductive

shoot components. Small net changes in shoot N content after flowering

reflected a balance between N import and export, leading to continuous dilution

of 15N labelled N with unlabelled N},
 author = {Schjoerring, J. K. and Bock, J.G.H. and Gammelvind, L. and Jensen, C.R and Mogensen, V. O.},
 year = {1995},
 title = {Nitrogen incorporation and remobilization in different shoot components of field-grown winter oilseed rape (Brassica napus L.) as affected by rate of nitrogen application and irrigation},
 pages = {255--264},
 volume = {177},
 number = {2},
 issn = {1573-5036},
 journal = {Plant and Soil}
}

