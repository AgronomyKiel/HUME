@article{Chapman2000,
 abstract = {The variable nature of rainfall in north-eastern Australia confounds the

process of selecting sorghum hybrids that are broadly adapted. This

paper uses a crop simulation model to characterise the drought

environment types (ET) that occur in the target population of

environments (TPE) for dryland sorghum. Seventy seasons (1921-1990) of

simulations of the yield of a sorghum genotype and the associated

within-season sequence of a stress index were conducted for a small TPE

of 6 locations and also for a large TPE of 211 locations that attempted

to represent the entire sorghum region.

Previously, using the small dataset of 6 locations, pattern analysis

enabled us to group seasonal stress indices from each trial into major

ETs: `low terminal stress' (ET1), severe terminal stress (ET2), and

intermediate mid-season/terminal stress (ET3) in the ratio 33 : 38 : 29.

When the dataset was broken into a sequence of 16 multi-environment

trials (METs), each of 3 years and 6 locations, the ratios of ET1 : ET2

: ET3 differed greatly among METs, i.e. any single MET was not randomly

sampling the TPE. Hence, for any MET, the average yield (GV(u)) was not

the same as the overall mean of the entire 70-year dataset. If the trial

yields were weighted according to the ratio of ET1 : ET2 : ET3 in the},
 author = {Chapman, S. C. and Hammer, G. L. and Butler, D. G. and Cooper, M.},
 year = {2000},
 title = {Genotype by environment interactions affecting grain sorghum. III.  Temporal sequences and spatial patterns in the target population of  environments},
 keywords = {Breeding;CULTIVAR;drought;Sorghum bicolor;TROPICAL},
 pages = {223--233},
 volume = {51},
 number = {2},
 issn = {0004-9409},
 journal = {Australian Journal of Agricultural Research},
 doi = {10.1071/AR99022}
}

