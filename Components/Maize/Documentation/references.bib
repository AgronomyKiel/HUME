 journal = {New Phytologist},
 doi = {10.1111/j.1469-8137.1994.tb03000.x}
}

@article{Gimenez1994,
 abstract = {Sunflowers cv. Sungro 385 were sown at 2 densities (5.7 and 2.9 plants m-2)

at Cordoba, Spain (lat. 38lN) on May 4, 1992 on a site of low N status. A high

N comparison was established with 25 g N m-2 applied in a split dressing of

15 and 10 g m-2 at 15 and 65 d after sowing (DAS). The growth of the 4

treatments (2 densities X 2 N levels) was measured at 41 and 56 DAS and

finally at flowering 71 DAS, as aboveground biomass in laminae and in stems

plus petioles. Leaf N concentration, the areas of all leaves, canopy light

interception and leaf photosynthesis were determined at intervals. Over the

experimental period to 71 DAS, N increased growth from 200 to 800 g m-2.

This response was almost equally the result of doubling light interception (1.9)

and radiation-use efficiency (RUE, 2.1). In the first stage of growth, up to 41

DAS, interception increased more (2.5) than did RUE (1.6). Maximum leaf

photosynthesis (at high irradiance) increased from 10 to 40 IJmol m-2 s-1 over

the range of specific leaf N concentration from 1.0 to 2.8 g N m-2. Analysis of

canopy photosynthesis with a simulation model showed that only a small part

(14{\%}) of the observed response in RUE could be attributed to greater

photosynthesis resulting from greater N content and its distribution in the

canopies. The major part therefore comprised undefined responses of

partioning of biomass to roots and to losses by respiration.},
 author = {Gimenez, C. and Connor, D. J. and Rueda, F.},
 year = {1994},
 title = {Canopy development, photosynthesis and radiation-use efficiency in sunflower in response to nitrogen},
 keywords = {canopy development, canopy light interception, leaf photosynthesis, nitogen, radiation-use efficiency, sunflower},
 pages = {15--27},
 volume = {38},
 number = {1},
 issn = {0378-4290},
 journal = {Field Crops Research}
}

