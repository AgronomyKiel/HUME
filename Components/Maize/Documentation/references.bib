@article{Werger1991,
 abstract = {Studies on the effect of canopy structure of a stand, and leaf N

distribution in the canopy, on C gain in open and dense canopies

of stands of herbaceous monocotyledonous or dicotyledonous

plants in vegetative or flowering stages, are reviewed. Canopies

of mono- and dicotyledonous plants are differently organized, and

long leaves of monocotyledonous plants place constraints on

optimal leaf N distribution. Leaf N distribution affects potential

canopy photosynthesis less in flowering than in vegetative

canopies. Leaf N distribution pattern in the canopy is vertically

non-uniform, and in dense stands more strongly so than in open

stands. The leaf N distribution pattern in most canopies closely

                             approaches an optimal pattern in that it maximizes whole canopy

                             potential C gain as calculated for the actual total leaf N content

                             and LAI of the stand. The resulting increase in potential C gain as

                             compared with a uniform leaf N distribution pattern is

                             considerable, and larger in dense than in open stands. For at

                             least some dense stands, simulation studies show that with the

                             available total leaf N content, whole canopy C gains could still be

                             considerably higher with a lower LAI.},
 author = {Werger, M. J. A. and Hirose, T.},
 year = {1991},
 title = {Leaf nitrogen distribution and whole canopy photosynthetic carbon gain in herbaceous stands},
 pages = {11--20},
 volume = {97},
 number = {1},
 journal = {Vegetation}
}

@article{Werker1997,
 abstract = {This paper discusses the derivation and fitting of three empirical models with turning points for describing the growth of plant components, such as shoot weight, leaf area and root length, that typically rise and then fall during the course of the growing season. The models (Models I, II and III) have analytical solutions and may be viewed as extensions of the Gompertz, Richards and Chanter growth equations. They differ by having an additional parameter which, following a sigmoidal rise of the dependent variable, determines subsequent net rate of decline. The models were fitted to sequential measures of foliage cover of sugar beet crops grown in the UK during 1980-1991. It was important that this could be done with relative ease using standard statistical procedures. Partial linear transformations of two of the models, with one non-linear parameter remaining, are described; these were useful for estimating initial values for the parameters. All three models described the data well, although the fitting of Model II invariably failed to converge. For Models I and III common and separate parameters, amongst years, were estimated relating to date of emergence, initial relative growth rate, maximum cover attained and rate of late season decline of foliage cover. The reduction in the residual mean square on fitting separate, rather than common, parameters was usually significant. The models accommodate several biological processes that yield similar shapes. This is demonstrated for Model I, in relation to its formulation and to effects of small perturbations in the values of the parameters on the shape of the curves. Model I, the simplest of the three models tested, has good fitting properties, and in practice was best suited to describing foliage cover dynamics of sugar beet. (C) 1997 Annals of Botany Company.},
 author = {Werker, A. R. and Jaggard, K. W.},
 year = {1997},
 title = {Modelling asymmetrical growth curves that rise and then fall: Applications to foliage dynamics of sugar beet (Beta vulgaris L)},
 keywords = {Beta vulgaris L sugar beet foliage cover senescence models;parameter estimation growth functions;productivity crops},
 pages = {657--665},
 volume = {79},
 number = {6},
 issn = {0305-7364},
 journal = {Annals of Botany}
}

