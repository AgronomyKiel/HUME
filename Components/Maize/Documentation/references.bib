@article{Bauer2020,
 abstract = {Das EU-Projekt Open Forecast entwickelt Services, die aus offenen Da­ ten mit HPC-Infrastrukturen neue Produkte erzeugen, die wiederum als offene Daten ver{\"o}ffentlicht werden sollen. Das Projekt entwickelt auto­matisierte Prozesse anhand von zwei Anwendungsf{\"a}llen: zum einen eine meteorologische Modellierung zur Feinstaubverteilung (PMFS), zum anderen ein Service zur Bereitstellung von Satellitendatenproduk­ten f{\"u}r die Landwirtschaft (AgriCOpen), der hier vertieft thematisiert wird. Es wird geschildert, wie multispektrale Satellitendaten in der Pr{\"a}zisionslandwirtschaft angewendet werden k{\"o}nnen und welche Vorverar­beitungs- und Prozessierungsschritte daf{\"u}r notwendig sind. Daf{\"u}r werden u. a. Vegetationsindizes mit einer r{\"a}umlichen Aufl{\"o}sung von 10m berechnet, die den j{\"a}hrlichen Vegetationsverlauf der Kulturpflanzen schlagbezogen abbilden.},
 author = {Bauer, Christian and Schilder, Dominik and Weis, Martin},
 year = {2020},
 title = {Die Augen der Sentinel -- Frei verf{\"u}gbare multispektrale Satellitendatenprodukte f{\"u}r die Pr{\"a}zisionslandwirtschaft},
 urldate = {2021-03-05},
 pages = {26--44},
 number = {2},
 journal = {Mitteilungsheft DVW Baden-W{\"u}rttemberg}
}

@article{Bauhus1999,
 abstract = {Image analysis systems facilitate rapid measurement of root length and diameter, but their accuracy is not easily

      determined. The objective of this study was to develop a set of simple experiments for evaluating the accuracy of

      fine root measurement obtained using image analysis. Using the system RHIZO (trademark of R{\'e}gent Instruments,

      Qu{\'e}bec), we tested the accuracy of (i) length of measurements made over a range of root lengths per unit area, (ii)

      average diameter measurements and length per diameter distributions in string, wire, and fine root samples of

      varying diameter, and (iii) diameter measurements on short segments of diagonally oriented objects. Our results

      suggest that preliminary testing of image analysis systems is absolutely necessary for producing reliable root

      measurements. Total length was accurately determined for typically encountered length per unit areas of {\textless}1.5 cm

      cm-2. For samples with higher values, however, the method underestimated total length by {\textgreater}5{\%}. It is therefore

      recommended that users of image analysis systems determine this maximum length per unit area for accurate

      determinations of total root length. In samples that contained different string diameters, the total sample length and

      average string diameter could accurately be measured. However, the length per diameter class was underestimated

      by {\textgreater}20{\%} when the string diameter was less than one pixel smaller than the upper limit of the diameter class.

      Adjustment of diameter intervals and increasing the scanner resolution are required to reduce this underestimation.

      Both the length and the angle of the short segments analyzed were found to influence diameter measurement.

      Similar sets of experiments are proposed for a rigorous evaluation of the performance of other image analysis

      systems on root measurements.},
 author = {Bauhus, J. and Messier, C.},
 year = {1999},
 title = {Evaluation of Fine Root Length and Diameter Measurements Obtained Using RHIZO Image Analysis},
 pages = {142--147},
 volume = {91},
 issn = {0002-1962},
 journal = {Agronomy Journal}
}

