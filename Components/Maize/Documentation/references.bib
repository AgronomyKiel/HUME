@article{Hoffmann2004,
 abstract = {Abstract Remote sensing and vegetation indices can be used to characterize the canopy of crops with a non-destructive method on a large scale. Leaf area formation of sugar beet in early summer is the most important variable for crop growth models. This study aimed at estimating whether differences in leaf area development of sugar beet resulting from different agronomic practices can be determined with remote sensing. The relationship between the normalized difference vegetation index (NDVI) and leaf area index (LAI) during the season and yield of the storage root in autumn was studied in six field trials in 2001 and nine field trials in 2002. The vegetation index NDVI gave a good impression of differences in leaf development of sugar beet in early summer. LAI increased with increasing NDVI up to an NDVI of 0.65. Above that the NDVI did not respond as distinctly to treatments as the LAI. An exponential function was developed to calculate sugar beet LAI from NDVI, so that remote sensing data can be used as input variable for crop growth models. The yield of the storage root in autumn did not show any relationship to LAI or NDVI during the season, regardless of whether it was measured in June or September. Therefore, it seems to be necessary to combine NDVI data with crop growth models to forecast a potential sugar beet yield in autumn. For this purpose the formula presented is a valuable tool.},
 author = {Hoffmann, C. M. and Blomberg, M.},
 year = {2004},
 title = {Estimation of Leaf Area Index of Beta vulgaris L. Based on Optical Remote Sensing Data},
 keywords = {agronomic practices;Leaf area index;NDVI;remote sensing;Root yield;Sugar beet},
 pages = {197--204},
 volume = {190},
 number = {3},
 issn = {0931-2250},
 journal = {Journal of Agronomy and Crop Science},
 doi = {10.1111/j.1439-037X.2004.00093.x}
}

@article{Hoffmann2006,
 abstract = {Possibilities to increase the yield potential of sugarbeet based on the physiological processes of yield formation are presented. For sugarbeet it seems to be promising to improve the yield potential through enhanced light interception of the crop. Early sowing, possibly already in autumn, results in accelerated leaf formation and thereby improved interception of the intense radiation in early summer. However, the possible yield increase of winter beet might be associated with a higher requirement for agronomic input. Since sugarbeet store sucrose as a low molecular carbohydrate their radiation use efficiency (produced biomass per intercepted radiation) is much higher compared to plants which produce proteins, long chain lipids or cellulose requiring a high internal input. Therefore, sugarbeet achieve a considerably higher yield potential at the same light interception. In the past, a shift from structural carbohydrates (cell wall material) to storage carbohydrates (sucrose) in the beet occurred. Thus, the observed yield increase may be attributed to a change in the harvest index. Furthermore, due to the lower input for the synthesis of sucrose as compared to cell wall material the yield increase may be realised without any changes in assimilation. However, cell wall stability possibly limits a further increase of the osmotic potential as a result of higher sucrose concentration.},
 author = {Hoffmann, C.},
 year = {2006},
 title = {Physiological basis of the yield potential of sugarbeet},
 keywords = {BOLTING GENE-B;Harvest index;Leaf area index;light interception;Radiation;sucrose concentration;sugarbeet;TEMPERATE MAIZE;use efficiency;winter beet;yield},
 pages = {863--870},
 volume = {131},
 number = {12},
 issn = {0344-8657},
 journal = {Zuckerindustrie}
}

