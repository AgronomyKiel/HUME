@article{Chen1997,
 abstract = {Coordination theory is used to develop a simple exponential model of

                          the allocation of dry matter between shoots and roots during plant growth

                          in relation to carbon and water supply, and the effects of water stress on

                          growth. Coordination is compared with optimization (global and local)

                          versions of the exponential model by examining similarities and

                          differences in model behaviour obtained under constant and variable

                          environmental conditions and with changing degrees of water stress. The

                          greatest differences between coordination and optimization occurred in

                          drastically changing conditions (mild, moderate and severe water

                          stress). In a second version of the model, the restriction of exponential

                          growth is removed and it is shown how coordination principles can be

                          extended to a more complicated structure. This non-exponential model is

                          used to analyse previously published experimental data on the effects of

                          different pot sizes (and hence water availability) on root restriction and

                          plant growth of cotton seedlings. It is concluded that the coordination

                          model has potential as a tool to model plant growth in relation to water

                          supply under various environmental conditions.},
 author = {Chen, J. L. and Reynolds, J. F.},
 year = {1997},
 title = {A coordination model of whole-plant carbon allocation in relation to water stress},
 pages = {45--55},
 volume = {80},
 issn = {0305-7364},
 journal = {Annals of Botany}
}

