@article{Retuerto1992,
 abstract = {Greenhouse experiments were conducted to examine how different wind

                           speeds and interactions between plant age and wind affect the growth and

                           biomass allocation of S. alba. Physiological and growth measurements were

                           made on individuals of S. alba grown in controlled-environment wind tunnels

                           at wind speeds of 0.3, 2.2 and 6.0 m/s for 42 d. Plants were harvested at 4

                           different dates. Increasing wind speed slightly increased transpiration and

                           stomatal conductance, but no significant decline in the photosynthetic rate per

                           unit of leaf area was observed. The number of leaves, stem length, leaf area

                           and DW of total biomass and plant parts were significantly lower in plants

                           exposed to high wind speed conditions. There were no significant differences

                           in the unit leaf rate nor relative growth rate, although these were always lower

                           in plants grown at high wind speed. Allocation and architectural parameters

                           were also examined. After 42 d of exposure to wind, plants showed higher

                           leaf area ratio, root and leaf wt ratios and root/shoot ratios than those grown

                           in the control treatment. Only the specific leaf area declined significantly with

                           wind speed, but stem and reproductive parts also decreased. The responses of

                           plants to each wind speed treatment depended on the age of the plant for most

                           of the variables. It is suggested that wind operates in a logarithmic manner,

                           with relatively small or no effects at lower wind speeds and a much greater

                           effect at higher speeds. Since there is no evidence of a significant reduction in

                           photosynthetic rate of S. alba with increasing wind speed, it is suggested that

                           the effect of wind on plant growth was due to mechanical effects leading to

                           changes in allocation and developmental patterns.},
 author = {Retuerto, R. and Woodward, F. I.},
 year = {1992},
 title = {Effects of windspeed on the growth and biomass allocation of white mustard, Sinapis alba L},
 pages = {113--123},
 volume = {92},
 issn = {0029-8549},
 journal = {Oecologia}
}

