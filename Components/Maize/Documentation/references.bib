@article{McMillan2011,
 abstract = {The effect of wheat cultivar on the build-up of take-all inoculum during a first wheat crop was measured after harvest using a soil core bioassay in field experiments over five growing seasons (2003-2008). Cultivar differences in individual years were explored by analysis of variance and a cross-season Residual Maximum Likelihood (REML) variance components analysis was used to compare differences in those cultivars present in all years. Differences between cultivars in the build-up of inoculum were close to or at significance in two of the five trial years (2004 P {\textless} 0 center dot 05; 2006 P {\textless} 0 center dot 07), and current commercially listed cultivars were represented at both extremes of the range. In 2007 and 2008, when environmental conditions were most favourable for inoculum build-up, differences were not significant (P {\textless} 0 center dot 3). In 2005 the presence of Phialophora spp. at the trial site restricted the build-up of take-all inoculum under all cultivars. The cross season REML variance components analysis detected significant differences (range: 3 center dot 4-47 center dot 8{\%} roots infected in the soil core bioassay; P {\textless} 0 center dot 01) between the nine cultivars present in all years (excluding 2005). This is the first evidence of relatively consistent differences between hexaploid wheat cultivars in their interactions with the take-all fungus, and this could give an indication of those cultivars that could be grown as a first wheat crop, in order to reduce the risk of damaging take-all in a second wheat crop. This phenomenon has been named the take-all inoculum build-up (TAB) trait.},
 author = {McMillan, V. E. and Hammond-Kosack, K. E. and Gutteridge, R. J.},
 year = {2011},
 title = {Evidence that wheat cultivars differ in their ability to build up inoculum of the take-all fungus, Gaeumannomyces graminis var. tritici, under a first wheat crop},
 keywords = {bioassay;disease;field;hexaploid wheat genotypes;inoculum build-up;nitrogen;phialophora;Phialophora spp;roots;soil;soil core;survival;take-all disease;Triticum aestivum;winter-wheat},
 pages = {200--206},
 volume = {60},
 number = {2},
 issn = {0032-0862},
 journal = {Plant Pathology},
 doi = {10.1111/j.1365-3059.2010.02375.x}
}

