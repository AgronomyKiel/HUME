@article{Connor1995,
 abstract = {Measurements of the profiles of leaf area and leaf N content were made on

                              5 occasions from mid-flowering to maturity (53, 61, 70, 78 and 83 d after

                              emergence, DAE) in sunflower crops grown at 2.4 and 4.8 plants/m2 and

                              given 0 and 5 g N/m2 at emergence in the summer in Buenos Aires, Argentina.

                              As the crops matured, N was withdrawn unequally by the plant from all leaf

                              positions and leaves senesced from the bases of the canopies upwards. A

                              model was used to estimate the daytime net photosynthesis (Pc) of canopies

                              of defined leaf area and N content under the observed conditions of

                              temperature and irradiance. Comparisons were made between the observed

                              profiles of leaf N and those that would maximize Pc (the optimal profiles). The

                              observed N profiles were suboptimal at mid-flowering, except in the

                              low-density, low-N treatment. The differences were most marked in the high-N

                              treatments which held excessive N in their lower canopies. As the canopies

                              matured and N was mobilized to the grain, LAI and total N content decreased

                              and optimal profiles changed shape from exponential to linear. During this

                              period observed profiles became more optimal. There was, however, little

                              difference in Pc between observed and optimal profiles. The maximum

                              difference was 3.2{\%} observed in the low-density, high-N treatment at 53 DAE.

                              The comparison of actual and optimal profiles of leaf N content in addition to

                              the more commonly used specific leaf N explained this result since relatively

                              large changes in SLN in the small leaves at the top of canopies had little effect

                              in Pc. The study indicated that leaf N content is an appropriate basis for

                              comparison of canopy N profiles in sunflower.},
 author = {Connor, D. J. and Sadras, V. O. and Hall, A. J.},
 year = {1995},
 title = {Canopy nitrogen distribution and the photosynthetic performance of sunflower crops during grain filling - a quantitative analysis},
 pages = {274--281},
 volume = {101},
 number = {3},
 issn = {0029-8549},
 journal = {Oecologia}
}

