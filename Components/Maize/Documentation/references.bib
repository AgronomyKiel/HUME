@article{Lemaire1991,
 abstract = {A Medicago sativa crop in the year after sowing was given 0 or 140

                             kg N/ha as ammonium nitrate in Feb. and after cutting on 20 May.

                             Stem samples were taken on 24 Apr., 9 May and 19 May from

                             plots not given N and on 22 and 30 June from both treatments, and

                             all samples were divided into 10-cm height classes and strata. The

                             N content of stems in mg/cm was constant from the top to the

                             base for a given stem height class and increased with the size of

                             the stem in relation to its diam. The N content of leaves in mg/cm

                             was constant within each 10-cm stratum of the canopy and did not

                             depend on stem class or leaf age. New leaves were initiated at the

                             top of the canopy at a relatively constant max. N content/cm,

                             which decreased regularly as these leaves became displaced to

                             shaded horizons. A relationship between the relative diminution of N

                             content per leaf area and the relative extinction of light from the

                             top to the bottom of the canopy was established. This relationship

                             suggested that the diminution in the N content of leaves was

                             influenced by the light level. One process could be concerned with

                             the adjustment of the photosynthetic capacity of leaves to the light

                             level and the other could correspond to senescence leading to leaf

                             death. This phenomenon was largely avoided if individual stems

                             were prevented from becoming shaded. About 80{\%} of leaf N was

                             lost by an individual leaf before abscission, and 70{\%} of the initial

                             stem N had been lost by an individual stem by the time the last leaf

                             dropped. The results are related to self-thinning processes which

                             occur during the regrowth dynamics of the canopy. The diminution

                             of the N content of individual stems and the death of stems

                             observed during regrowth can be considered as reflections of the

                             competition for light.},
 author = {Lemaire, G. and Onillon, B. and Gosse, G. and Chartier, M. and Allirand, J. M.},
 year = {1991},
 title = {Nitrogen distribution within a lucerne canopy during regrowth: relation with light distribution},
 pages = {483--488},
 volume = {68},
 number = {6},
 issn = {0305-7364},
 journal = {Annals of Botany}
}

@article{Lemaire1992,
 abstract = {Quantitative relationships were established which defined the partitioning of nitrogen and dry matter between the leaves, stems and roots during the development of field grown lucerne. The coefficients were unaffected by whether or not N fertilizer was applied. The average {\%} N in the aerial tissue fell sharply with increase in plant mass when aerial DM of the crop exceeded 1 t ha-1. This was mainly because the proportion of stems increased and the {\%} N in stems was low. The often-reported decline in {\%} N with decrease in light intensity and increasing depth within the canopy was largely offset by a, decline in specific leaf weight, so that the average {\%} N of the leaves declined only slightly as the plants grew. The average {\%} N of the entire plant (aerial plus root tissues) remained constant at about 2.4 irrespective of plant size. After cutting, regrowth was accompanied by a rapid transfer of up to 40 kgN ha-1 from root to shoot, but this loss was made good by N fixation during the main growing period.},
 author = {Lemaire, Gilles and Khaity, Mahmoun and Onillon, Bertrand and Allirand, Jean Michel and Chartier, Michel and Gosse, Ghislain},
 year = {1992},
 title = {Dynamics of Accumulation and Partitioning of N in Leaves, Stems and Roots of Lucerne (Medicago sativa L.) in a Dense Canopy},
 pages = {429--435},
 volume = {70},
 number = {5},
 journal = {Ann Bot}
}

