 keywords = {applied statistics;complex loci;complexe loci;Crops;genotype environment interaction;genotype-milieu interactie;gewassen;kwantitatieve genetica;QUANTITATIVE GENETICS;toegepaste statistiek},
 address = {Wageningen},
