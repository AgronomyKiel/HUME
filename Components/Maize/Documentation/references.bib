@article{Grant1993,
 abstract = {Soil compaction is understood to reduce root growth by increasing soil resistance to root elongation and by decreasing O2 transport to root surfaces. Although mathematical models have been proposed for each of these processes, there remains a need for a more comprehensive model of root growth if the effects of soil compaction on carbon and nutrient cycling are to be represented in larger ecosystem simulation models. In the model presented here, root growth simulated in each horizontal layer of the soil profile is taken to be the lesser of that enabled by soil strength and that by carbon respiration. Soil strength is calculated from the bulk modulus of soil elasticity, estimated from bulk density, water content and organic matter content, and carbon respiration is estimated from the availability of O2, nutrients and reduced carbon in the roots. This model represents an attempt to integrate the effects on root growth of soil physical characteristics, such as water content and bulk density, with those of soil chemical characteristics, such as nutrient and O2 concentrations, and those of plant biological activity, such as the production of reduced carbon. The mathematical equations on which the model is based are presented, and the behaviour of the model is discussed. Further knowledge of how root branching is controlled will be needed for further model development. In the accompanying article, this model of root growth is tested against experimental data recorded in soil columns at different soil bulk densities. [References: 52]},
 author = {Grant, R. F.},
 year = {1993},
 title = {Simulation model of soil compaction and root growth  1. Model structure},
 keywords = {Environment/ecology.;Mathematical-models. Special emphasis. Winter-wheat. Plant-roots. Water. Oxygen. Maize. Photosynthesis. Diffusion. Denitrification.;nutrient uptake, oxygen movement, oxygen uptake, root respiration, root growth, simulation modelling, soil bulk density, soil resistance.},
 pages = {1--14},
 volume = {150},
 number = {1},
 issn = {1573-5036},
 journal = {Plant and Soil}
}

@article{Grant1993b,
 abstract = {Soil compaction is a widespread cause of reduced plant productivity. If the effects of soil compaction on plant growth are to be reproduced in simulation models, then the processes through which compaction reduces root elongation must be expressed mathematically and then tested against experimental data. The mathematical theory by which these processes may be represented is given in the accompanying article. In this article, the behavior of a simulation model based on this theory is tested against data for root growth and soil gas concentration recorded from soil columns of which the middle layers were compacted to different bulk densities. The model was able to reproduce the failure of the root system to penetrate the compacted middle layer within the period of the experiment when bulk density exceeded 1.55 Mg m-3. The model also reproduced decreases in O2 concentrations, and increases in CO2 concentrations, in the atmospheres of the compacted layer and of the uncompacted layer below it as bulk density of the compacted layer increased. The simulated time course of O2 and nutrient uptake and of O2 concentrations in the compacted layer at different depths is presented and its consistency with experimental findings is examined. As part of a larger ecosystem model, this model will be useful in estimating site-specific effects of soil compaction on carbon cycling in agroecosystems. [References: 34]},
 author = {Grant, R. F.},
 year = {1993},
 title = {Simulation model of soil compaction and root growth . 2. model performance and validation},
 keywords = {Environment/ecology.;Mechanical impedance. Oxygen. Diffusion.;Soil bulk density. Soil resistance. Root growth. Root length density. Oxygen uptake. Nutrient uptake. Simulation modelling.},
 pages = {15--24},
 volume = {150},
 number = {1},
 issn = {1573-5036},
 journal = {Plant and Soil}
}

