#| label: tbl-TextureBDeffect
#| tbl-cap: Effective rooting depth [dm] and relative effective rooting depth [-] for different soil textures and bulk density classes.
library(dplyr)
library(DT)
library(htmlwidgets)
fn <- "Components/Rootgrowth/Documentation/Weff.csv"
df.Weff <- read.csv(fn, header = TRUE, comment.char = "[", sep = ",", dec = ".")
names(df.Weff) <- c("Texture","BD", "Weff", "Weffrel")
num_cols <- names(df.Weff)[sapply(df.Weff, is.numeric)]
datatable(
df.Weff,
rownames = FALSE,
filter = "top",
options = list(
pageLength = 8,
autoWidth = TRUE,
scrollX = TRUE
),
callback = JS(
"table.on('init.dt', function() {",
"  var headerRows = $(table.table().header()).find('tr');",
"  if (headerRows.length > 1) {",
"    $(headerRows[1]).find('th').each(function(i) {",
"      if (i > 1) {",
"        $(this).html('');",
"      }",
"    });",
"  }",
"});"
)
) %>%
formatRound(columns = num_cols, digits = 3, dec.mark = ".")
#| label: rooting-depth-static-interactive
#| echo: false
#| message: false
#| warning: false
#| include: true
#| fig-cap: "Effect of texture and bulk density on rooting depth dynamics"
library(dplyr)
library(tidyr)
library(plotly)
library(crosstalk)
library(htmltools)
# Assumptions:
# df.Weff contains columns Texture, BD, Weffrel
bzr <- 0.1
zrmax <- 120
tsum_max <- 2000
plot_df <- df.Weff %>%
transmute(
texture = Texture,
bulkdensity = BD,
Weffrel = Weffrel
) %>%
filter(!is.na(texture), !is.na(bulkdensity), !is.na(Weffrel)) %>%
distinct() %>%
expand_grid(TSUM = seq(0, tsum_max, by = 10)) %>%
mutate(
zrmax_eff = zrmax * Weffrel,
zr = pmin(zrmax_eff, TSUM * bzr * Weffrel),
scenario = paste0(
"Texture=", texture,
", BD=", bulkdensity,
", Weffrel=", round(Weffrel, 3)
)
)
sd <- SharedData$new(plot_df, group = "rooting")
bscols(
widths = c(3, 9),
list(
filter_select("texture", "Texture class", sd, ~texture, multiple = TRUE),
filter_select("bd", "Bulk density class", sd, ~bulkdensity, multiple = TRUE)
),
plot_ly(
sd,
x = ~TSUM,
y = ~zr,
color = ~scenario,
type = "scatter",
mode = "lines",
hovertemplate = paste(
"TSUM=%{x}",
"<br>zr=%{y}",
"<extra>%{fullData.name}</extra>"
)
) %>%
layout(
title = "Effect of texture and bulk density on rooting depth dynamics",
xaxis = list(title = "Temperature sum (TSUM [°C d])"),
yaxis = list(title = "Rooting depth zr (cm)", autorange = "reversed")
)
)
#| label: LrvExample
#| message: false
#| warning: false
#| include: false
# Root length density at depth 0
Lrv0 <- 4 # cm.cm-3
# depth Lrv decrease parameter
kr <- 0.03
# sequence of depths
z <- seq(0, 150, 5)
# sequence of root length densities
Lrv <- Lrv0*exp(-kr*z)
#plot(Lrv, -z )
# integration over depth gives total root length per area
Lr <- Lrv0/kr*(1-exp(-kr*max(z)))
#cat("For these values of Lrv0 and kr the total root length is", format(Lr, digits=4), "cm/cm2.")
#| label: fig-LrvDepth
#| echo: false
#| fig-align: center
#| fig-cap: Root length density (Lrv) vs. depth
#| fig-height: 3.5
#| fig-width: 3
#plot(Lrv, -z , type = "l", ylab="depth [cm]", xlab = "Lrv [cm/cm3]")
illu <- data.frame(-z, Lrv)
minor_breaks <- rep(1:9, 21)*(10^rep(-10:10, each=9))
MyBreaks <- c(1, 10, 100, 1000, 10000)
m <- NULL
m <-ggplot(data=illu)
m <- m + geom_line(aes(x=Lrv, y=z),lwd=1, lty=1, color="brown")
m <- m + scale_colour_brewer(palette="Set1")
m <- m + scale_y_reverse()
m <- m + scale_fill_brewer(palette="Set1")
m <- m + scale_x_continuous(position = "top")
m <- m + xlab("Lrv [cm/cm³]") + ylab("depth [cm]")
#m <- set_theme(m,14)
m <- m + theme_bw(base_size = 14)
#ggsave(filename = "LRV_depth.png", plot=m, units="cm", dpi = 300, height=15, width=22, bg = "transparent")
m
