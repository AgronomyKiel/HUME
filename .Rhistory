#| warning: false
#| include: false
fn <- "csv_Hume_Docu/GrowthCurvePlantRoots1.csv"
df <- read.delim(fn, header = TRUE, sep = ";", fileEncoding = "UTF-8-BOM")
df.state <- df %>% filter(Submodel == "GrowthCurvePlantRoots1", EntityType == "State") %>% dplyr::select(EntityName, Units, Value, Comment)
names(df.state) <- c("State variable", "Units", "InitialValue", "Description")
#| label: StateVariablesOutput
#| echo: false
#| message: false
#| warning: false
kable(df.state)
#| label: Parameters
#| message: false
#| warning: false
#| include: false
df.par <- df %>% filter(Submodel == "GrowthCurvePlantRoots1", EntityType == "Parameter") %>% dplyr::select(EntityName, Units, Value, Comment)
names(df.par) <- c("Parameter", "Units", "Value", "Description")
#| label: ParametersOutput
#| echo: false
#| message: false
#| warning: false
kable(df.par,  escape = FALSE)
#| label: Variables
#| message: false
#| warning: false
#| include: false
df.var <- df %>% filter(Submodel == "GrowthCurvePlantRoots1", EntityType == "Variable") %>% dplyr::select(EntityName, Units, Comment)
names(df.var) <- c("Variable", "Units", "Description")
#| label: VariablesOutput
#| echo: false
#| message: false
#| warning: false
kable(df.var,  escape = FALSE)
#| label: ExternalVariables
#| message: false
#| warning: false
#| include: false
df.ext <- df %>% filter(Submodel == "GrowthCurvePlantRoots1", EntityType == "ExtVar") %>% dplyr::select(EntityName, Units, Comment, Option)
names(df.ext) <- c("External variable", "Units", "Description", "Source")
#| label: ExternalVariablesOutput
#| echo: false
#| message: false
#| warning: false
kable(df.ext,  escape = FALSE)
#| label: Options
#| message: false
#| warning: false
#| include: false
df.opt <- df %>% filter(Submodel == "GrowthCurvePlantRoots1",EntityType == "Option" ) %>% dplyr::select(EntityName, Units, Comment)
names(df.opt) <- c("Option", "Units", "Description")
#| label: OptionsOutput
#| echo: false
#| message: false
#| warning: false
kable(df.opt,  escape = FALSE)
