#| fig-cap: Examples of reduction function with either log scale or linear dependency on soil matrix potential.
psi_2 <- 200
linpsis <- seq(from=0, to = 10^4.2, by=100)
logpsis <-  seq(from=1, to = 4.2, by=0.05)
fred_lin <- pmax(0, pmin(1, (linpsis-10^4.2)/(psi_2-10^4.2)))
fred_log <- pmax(0, pmin(1, (logpsis-4.2)/(log10(psi_2)-4.2)))
df1 <- data.frame(psi = linpsis, fred = fred_lin, type = "linear")
df2 <- data.frame(psi = logpsis, fred = fred_log, type = "log")
df1$logpsi <- log10(df1$psi)
df1$linpsi <- df1$psi
df2$logpsi <- df2$psi
df2$linpsi <- 10^df2$psi
df <- rbind(df1, df2)
p1 <- ggplot(df1, aes(x = logpsi, y = fred), color = "red") +
geom_line(size=1.5) +
geom_abline(intercept = log10(psi_2), slope = 0, linetype = "dashed", color = "blue") +)
