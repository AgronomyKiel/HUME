#| fig.height: 7
#| fig-cap: Examples of reduction function with either log scale or linear dependency on soil matrix potential.
psi_2 <- 200
linpsis <- seq(from=0, to = 10^4.2, by=100)
logpsis <-  seq(from=1, to = 4.2, by=0.05)
fred_lin <- pmax(0, pmin(1, (linpsis-10^4.2)/(psi_2-10^4.2)))
fred_log <- pmax(0, pmin(1, (logpsis-4.2)/(log10(psi_2)-4.2)))
df1 <- data.frame(psi = linpsis, fred = fred_lin, type = "linear")
df2 <- data.frame(psi = logpsis, fred = fred_log, type = "log")
df1$logpsi <- log10(df1$psi)
df1$linpsi <- df1$psi
df2$logpsi <- df2$psi
df2$linpsi <- 10^df2$psi
df <- rbind(df1, df2)
p1 <- ggplot(df1, aes(x = logpsi, y = fred), color = "red") +
geom_line(size=1.5) +
geom_vline(xintercept = log10(psi_2),  linetype = "dashed", color = "blue") +
#  scale_color_manual(values = c("blue", "red"), labels = c("linear", "log")) +
labs(title = "linear-scaled", x = "pF  (log10(psi))", y = "Reduction factor for root water uptake", color = "Scale") +
scale_x_continuous(limits=c(1,5), breaks=c(1,2,3,4,5), labels=c("1","2","3","4","5")) +
theme_minimal(base_size = 22)
#p1
p2 <- ggplot(df2, aes(x = logpsi, y = fred), color = "blue") +
geom_line(size=1.5) +
geom_vline(xintercept = log10(psi_2),  linetype = "dashed", color = "blue") +
labs(title = "log scaled", x = "pF  (log10(psi))", y = "Reduction factor for root water uptake", color = "Scale") +
scale_x_continuous(limits=c(1,5), breaks=c(1,2,3,4,5), labels=c("1","2","3","4","5")) +
theme_minimal(base_size = 22)
p <- p1 + p2 + plot_layout( guides = "collect") & theme(legend.position = "bottom", axis_titles="collect")
p
#| echo: false
#| message: false
#| warning: false
#| label: fig-psi2redf
#| fig.height: 7
#| fig-cap: Examples of reduction function with either log scale or linear dependency on soil matrix potential. Dotted blue line indicates the value of psi_2, the soil water potential from which on water uptake decrease.
psi_2 <- 200
linpsis <- seq(from=0, to = 10^4.2, by=100)
logpsis <-  seq(from=1, to = 4.2, by=0.05)
fred_lin <- pmax(0, pmin(1, (linpsis-10^4.2)/(psi_2-10^4.2)))
fred_log <- pmax(0, pmin(1, (logpsis-4.2)/(log10(psi_2)-4.2)))
df1 <- data.frame(psi = linpsis, fred = fred_lin, type = "linear")
df2 <- data.frame(psi = logpsis, fred = fred_log, type = "log")
df1$logpsi <- log10(df1$psi)
df1$linpsi <- df1$psi
df2$logpsi <- df2$psi
df2$linpsi <- 10^df2$psi
df <- rbind(df1, df2)
p1 <- ggplot(df1, aes(x = logpsi, y = fred), color = "red") +
geom_line(size=1.5) +
geom_vline(xintercept = log10(psi_2),  linetype = "dashed", color = "blue") +
#  scale_color_manual(values = c("blue", "red"), labels = c("linear", "log")) +
labs(title = "linear-scaled", x = "pF  (log10(psi))", y = "Reduction factor for root water uptake", color = "Scale") +
scale_x_continuous(limits=c(1,5), breaks=c(1,2,3,4,5), labels=c("1","2","3","4","5")) +
theme_minimal(base_size = 22)
#p1
p2 <- ggplot(df2, aes(x = logpsi, y = fred), color = "blue") +
geom_line(size=1.5) +
geom_vline(xintercept = log10(psi_2),  linetype = "dashed", color = "blue") +
labs(title = "log scaled", x = "pF  (log10(psi))", y = "Reduction factor for root water uptake", color = "Scale") +
scale_x_continuous(limits=c(1,5), breaks=c(1,2,3,4,5), labels=c("1","2","3","4","5")) +
theme_minimal(base_size = 22)
p <- p1 + p2 + plot_layout( guides = "collect") & theme(legend.position = "bottom", axis_titles="collect")
p
ggsave("Components/Soil/Documentation/Figures/psi2redf.png", p, width = 12, height = 6, dpi = 400)
# Retrieve water-content values from the data stored in each plot
fill_limits <- range(
p1$layers[[1]]$data$theta_cm3_cm3,
p2$layers[[1]]$data$theta_cm3_cm3,
na.rm = TRUE
)
p <- (
(p1 + p2) +
plot_layout(ncol = 2, guides = "collect")
) &
scale_fill_gradient(
low = "white",
high = "blue",
limits = fill_limits,
name = "Water Content [cm³/cm³]"
) &
theme(
legend.position = "bottom",
legend.title = element_text(size = 12),
legend.text = element_text(size = 10)
)
p
